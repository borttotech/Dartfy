# Endereço público do app (usado nos links de convite e metadados).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Sem estas variáveis o app roda em MODO DEMO (dados em memória, usuário fixo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor (webhooks de pagamento). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mercado Pago (Pix). Somente servidor.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
